cmake_minimum_required(VERSION 3.20)
if(NOT EXISTS "${IMPORT_TOOL}" OR NOT WORK_ROOT)
    message(FATAL_ERROR "IMPORT_TOOL and WORK_ROOT are required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(root "${WORK_ROOT}/${nonce}/导入 配方")
file(MAKE_DIRECTORY "${root}/Assets" "${root}/.ayeditor/imports")
set(source [=[{"asset":{"version":"2.0"},"buffers":[{"uri":"data:application/octet-stream;base64,AAAAAAAAAAAAAAAAAACAPwAAAAAAAAAAAAAAAAAAgD8AAAAA","byteLength":36}],
"bufferViews":[{"buffer":0,"byteLength":36}],"accessors":[{"bufferView":0,"componentType":5126,"count":3,"type":"VEC3","min":[0,0,0],"max":[1,1,0]}],
"meshes":[{"name":"Triangle","primitives":[{"attributes":{"POSITION":0}}]}],"nodes":[{"mesh":0}],"scenes":[{"nodes":[0]}],"scene":0}]=])
file(WRITE "${root}/Assets/Triangle.gltf" "${source}")
set(cookEnv 0)
function(run_import expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "AY_IMPORT_COOK_TEXTURES=${cookEnv}"
        "${IMPORT_TOOL}" ${ARGN}
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(expected STREQUAL "ok" AND NOT "${code}" STREQUAL "0")
        message(FATAL_ERROR "import failed (${code}): ${output}\n${errors}")
    elseif(expected STREQUAL "fail" AND "${code}" STREQUAL "0")
        message(FATAL_ERROR "invalid request unexpectedly succeeded: ${output}")
    endif()
    set(importOutput "${output}\n${errors}" PARENT_SCOPE)
endfunction()

# Use the production codec's complete settings from a genuine seed import.
run_import(ok --in "${root}/Assets/Triangle.gltf" --out "${root}/seed" --no-character)
file(READ "${root}/seed/Triangle.dep" metadata)
string(JSON settings GET "${metadata}" import settings)
string(JSON settings SET "${settings}" outputNamespace "\"source-cli\"")
set(recipe [=[{"format":"ay.import-recipe","version":1,"source":"Assets/Triangle.gltf","output":".ayeditor_cache/assets","sourceId":"source-cli","settings":@SETTINGS@}]=])
string(REPLACE "@SETTINGS@" "${settings}" recipe "${recipe}")
set(recipePath "${root}/.ayeditor/imports/source-cli.json")
file(WRITE "${recipePath}" "${recipe}")

run_import(ok --project "${root}" --list-recipes)
if(NOT importOutput MATCHES "source-cli")
    message(FATAL_ERROR "recipe listing omitted its stable ID")
endif()
run_import(ok --project "${root}" --recipe source-cli)
set(sidecar "${root}/.ayeditor_cache/assets/source-cli.dep")
file(READ "${sidecar}" metadata)
string(JSON namespace GET "${metadata}" import settings outputNamespace)
string(JSON sourceId GET "${metadata}" import sourceId)
string(JSON outputPath GET "${metadata}" resources 0 path)
if(NOT namespace STREQUAL "source-cli" OR NOT sourceId STREQUAL "source-cli"
    OR NOT outputPath MATCHES "^meshes/source-cli/")
    message(FATAL_ERROR "CLI did not retain recipe identity/settings")
endif()
set(cookEnv 1)
run_import(ok --project "${root}" --recipe source-cli)
if(NOT importOutput MATCHES "cache=hit")
    message(FATAL_ERROR "environment silently overrode the authored cook setting")
endif()
set(cookEnv 0)
run_import(fail --project "${root}" --recipe source-cli --mesh-only)
run_import(fail --project "${root}" --recipe missing)
run_import(fail --recipe source-cli)
run_import(fail --project "${root}" --list-recipes --force)

foreach(invalid nan -1 0.1garbage)
    run_import(fail --in "${root}/Assets/Triangle.gltf" --out "${root}/invalid-units"
        --no-character --source-meters-per-unit "${invalid}")
endforeach()
if(EXISTS "${root}/invalid-units")
    message(FATAL_ERROR "invalid unit arguments created derived output")
endif()

file(SHA256 "${sidecar}" previous)
file(WRITE "${root}/Assets/Triangle.gltf" "broken source")
run_import(fail --project "${root}" --recipe source-cli --force)
file(SHA256 "${sidecar}" retained)
if(NOT previous STREQUAL retained)
    message(FATAL_ERROR "failed CLI reimport replaced previous metadata")
endif()
file(WRITE "${root}/Assets/Triangle.gltf" "${source}")
run_import(ok --project "${root}" --recipe source-cli --force)
run_import(ok --project "${root}" --recipe source-cli --out "${root}/alternate")
if(NOT EXISTS "${root}/alternate/source-cli.dep")
    message(FATAL_ERROR "explicit output override did not publish")
endif()
file(SHA256 "${sidecar}" previous)
file(WRITE "${recipePath}" "{}")
run_import(fail --project "${root}" --recipe source-cli)
file(SHA256 "${sidecar}" retained)
if(NOT previous STREQUAL retained)
    message(FATAL_ERROR "invalid recipe changed previous output")
endif()
message(STATUS "PASS import recipe CLI, Unicode paths, complete settings, cache, failure retention: ${root}")
